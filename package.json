{
  "name": "r3f-jolt",
  "version": "1.0.0",
  "description": "JoltFoundry: material-aware soft bodies, containment, and fracture for React Three Fiber",
  "keywords": [
    "react-three-fiber",
    "r3f",
    "three",
    "jolt",
    "physics",
    "soft-body",
    "wasm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HyperExtendedReality/r3f-jolt.git"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run build:lib && npm run build:demo",
    "build:lib": "tsup",
    "build:demo": "vite build",
    "test": "npm run build:lib && node tests/physics.test.mjs",
    "prepare": "npm run build:lib",
    "preview": "vite preview",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "react": ">=18",
    "@react-three/fiber": ">=8",
    "three": ">=0.160.0",
    "jolt-physics": ">=1.0.0"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^6.0.1",
    "jolt-physics": "^1.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.183.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.3"
  }
}
